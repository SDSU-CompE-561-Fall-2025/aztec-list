# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================================================
# This file configures the FastAPI backend server.
# Copy this file to .env in the backend/ directory and update values as needed.
#
# For FRONTEND configuration, see ../frontend/.env.example
# ============================================================================

# Application settings
APP__TITLE="Aztec List"
APP__DESCRIPTION="API for an OfferUp-style marketplace for college students"
APP__VERSION="0.1.0"
APP__DOCS_URL="/docs"
APP__REDOC_URL="/redoc"
# Deployment environment. Set to "production" to force-disable /docs, /redoc, and
# /openapi.json regardless of the URL settings above. Default ("development") leaves
# them on so local exploration works.
APP__ENVIRONMENT="development"

# Security settings (REQUIRED - generate a secure secret key!)
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT__SECRET_KEY="CHANGE_ME_generate_a_secure_random_key_here"
JWT__ALGORITHM="HS256"
# Token expiration in minutes (default 480 = 8 hours, a full marketplace session).
# Frontend stores tokens in localStorage and will require re-login after expiration.
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database settings
# For local development with SQLite (default):
# The database file will be created in the backend/ directory when you run the app
# DB__DATABASE_URL="sqlite:///./aztec_list.db"

# For PostgreSQL (production):
DB__DATABASE_URL="postgresql://user:password@localhost:5432/aztec_list"

# Database configuration
DB__ECHO=false

# Moderation settings
# Number of strikes before automatic permanent ban
MODERATION__STRIKE_AUTO_BAN_THRESHOLD=3
# Enable the AI second-pass that flags borderline new listings for human review (requires
# AI__ENABLED). The keyword filter still hard-blocks known violations regardless of this.
MODERATION__AI_REVIEW_ENABLED=false
# Enable AI image moderation on photo uploads (requires AI__ENABLED + an Anthropic key for Claude
# vision). Flags borderline images to the review queue.
MODERATION__AI_IMAGE_REVIEW_ENABLED=false

# Listing settings
# Maximum number of images allowed per listing
LISTING__MAX_IMAGES_PER_LISTING=10

# Storage settings (File uploads)
# Directory for storing uploaded images (relative to backend root)
STORAGE__UPLOAD_DIR="uploads/images"
# Maximum file size in megabytes for image uploads
STORAGE__MAX_FILE_SIZE_MB=5
# Allowed file extensions for image uploads (JSON array)
STORAGE__ALLOWED_EXTENSIONS='[".jpg", ".jpeg", ".png", ".webp", ".gif"]'
# Allowed MIME types for image uploads (JSON array)
STORAGE__ALLOWED_MIME_TYPES='["image/jpeg", "image/png", "image/webp", "image/gif"]'

# CORS settings
# WARNING: The default localhost origins are for DEVELOPMENT ONLY!
# In PRODUCTION, you MUST override these with your actual frontend domain(s).
# Examples:
#   - Production: '["https://azteclist.example.com"]'
#   - Staging: '["https://staging.azteclist.example.com"]'
#   - Multiple: '["https://app.example.com", "https://admin.example.com"]'
#
# WARNING: NEVER use "*" (wildcard) with CORS__ALLOW_CREDENTIALS=true - this is a security risk!
#
# Comma-separated list of allowed origins (frontend URLs)
# Default is localhost:3000 for Next.js frontend development
CORS__ALLOWED_ORIGINS='["http://localhost:3000"]'
# Allow credentials (cookies, authorization headers) - required for authentication
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOWED_METHODS='["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]'
CORS__ALLOWED_HEADERS='["*"]'
# Primary frontend URL for email links and redirects
# This should be your canonical frontend domain (e.g., in production: https://azteclist.example.com)
CORS__FRONTEND_URL="http://localhost:3000"

# Logging settings
# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL (enum values only)
LOGGING__LEVEL="INFO"
# Use JSON format for logs (recommended for production, false for development)
LOGGING__USE_JSON=false
# Format string for non-JSON logs
LOGGING__FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
# Uvicorn access log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOGGING__UVICORN_ACCESS_LEVEL="WARNING"
# Uvicorn error log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOGGING__UVICORN_ERROR_LEVEL="INFO"
# Paths to exclude from detailed request logging
LOGGING__EXCLUDED_PATHS='["/health", "/docs", "/redoc", "/openapi.json"]'

# Email settings (for Resend)
# Sign up at https://resend.com to get your API key
EMAIL__RESEND_API_KEY=""
# Email address to use as the "from" address
# EMAIL CONFIGURATION GUIDANCE:
# For TESTING (no verified domain):
#   - EMAIL__FROM_EMAIL: Use "onboarding@resend.dev"
#   - EMAIL__SUPPORT_EMAIL: Use your personal verified email (the one you used to sign up for Resend)
#     Only emails sent to EMAIL__SUPPORT_EMAIL will be delivered.
# For PRODUCTION (with verified domain):
#   - EMAIL__FROM_EMAIL: Use an email from your verified domain (e.g., "noreply@yourdomain.com")
#   - EMAIL__SUPPORT_EMAIL: Can be any email address where you want to receive support requests
#   - Do NOT use @gmail.com, @yahoo.com, or other public email domains as FROM address
EMAIL__FROM_EMAIL="onboarding@resend.dev"
# For testing, this should be your personal verified email. For production, set to your support email.
EMAIL__SUPPORT_EMAIL="your-verified-email@example.com"
# Enable/disable email sending (set to false if you don't want to use email notifications)
EMAIL__ENABLED=true

# Rate limiting settings
# Master switch to enable/disable all rate limiting
# Set to false for testing or emergency situations (not recommended in production)
RATE_LIMIT__ENABLED=true

# Test mode settings
# Enable test-only endpoints (NEVER enable in production!)
# When enabled, provides endpoints like /api/v1/test/promote-to-admin for E2E testing
TEST__TEST_MODE=false

# ============================================================================
# AI / SEMANTIC SEARCH (Phase 1)
# ============================================================================
# Master switch for AI features. When false, listing search uses keyword
# matching only and no embedding model is loaded (no startup cost).
AI__ENABLED=false

# Local embedding model (fastembed) - runs offline, no API key required.
# Downloaded to a local cache on first use.
EMBEDDING__MODEL="BAAI/bge-small-en-v1.5"

# Vector store (Qdrant).
# Leave VECTOR__QDRANT_URL empty to use an embedded on-disk Qdrant at VECTOR__PATH
# (single-process; fine for a local dev server). Set it to a server URL when
# running the Qdrant container: http://localhost:6333 locally, http://qdrant:6333
# inside Docker Compose.
VECTOR__QDRANT_URL=""
# API key for a managed Qdrant server (Qdrant Cloud). Only used when VECTOR__QDRANT_URL
# is set; leave empty for a local/unauthenticated Qdrant.
VECTOR__QDRANT_API_KEY="" # gitleaks:allow (empty placeholder, set your real key in .env)
VECTOR__PATH="./qdrant_data"
VECTOR__COLLECTION="listings"
# Semantic relevance cutoff (two layers, both tunable):
# - SCORE_FLOOR: absolute min cosine; if the best hit is below it, the query matches nothing.
# - RELATIVE_MARGIN: keep listings within this cosine margin of the best hit. Adapts to each
#   query's score scale (more robust than a fixed threshold). Smaller = stricter;
#   set RELATIVE_MARGIN high (e.g. 2.0) to disable relative trimming.
VECTOR__SCORE_FLOOR=0.40
VECTOR__RELATIVE_MARGIN=0.05

# Generative LLM for the AI shopping assistant (RAG). Provider abstraction:
# - 'ollama' (default, local, free): run `ollama serve` and `ollama pull qwen3.5:4b`.
# - 'anthropic' (Claude): set LLM__PROVIDER=anthropic and LLM__ANTHROPIC_API_KEY.
LLM__PROVIDER=ollama
# Provider for assist + moderation tasks (auto-description, listing moderation). Empty falls back
# to LLM__PROVIDER. Set 'anthropic' for the hybrid setup (Claude for these, local model for chat).
LLM__ASSIST_PROVIDER=""
# Local chat model. The default is laptop-friendly; bump to qwen3.5:9b (or larger) for better
# answers if your machine has the RAM/VRAM (9b is ~6.6GB and wants ~8GB+ free memory).
LLM__OLLAMA_MODEL="qwen3.5:4b"
LLM__OLLAMA_BASE_URL="http://localhost:11434"
LLM__ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
LLM__ANTHROPIC_API_KEY="" # gitleaks:allow (empty placeholder, set your real key in .env)
LLM__TEMPERATURE=0.2
# How many listings to ground the assistant with per question.
LLM__RETRIEVAL_K=6
# Use the LLM to expand vague searches into product keywords before embedding (improves recall
# on short titles, e.g. "something to listen to music" -> "headphones earbuds audio"). Adds a
# small LLM call per smart-search; falls back to the raw query if the LLM is unavailable.
LLM__EXPAND_QUERIES=true
# Per-request timeout for one-shot LLM/vision calls (moderation, auto-description). On timeout
# the call fails open so a slow provider does not hang listing creation or image uploads.
LLM__REQUEST_TIMEOUT_SECONDS=25

# Database connection pool (ignored for SQLite). Sized for a single backend instance behind a
# pooler; bump pool_size + max_overflow if you scale to more workers/replicas.
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=10
DB__POOL_RECYCLE_SECONDS=1800

# ============================================================================
# PRODUCTION OVERRIDES CHECKLIST
# ============================================================================
# Before deploying, verify every item below is set for the live environment:
#
#   [ ] APP__ENVIRONMENT="production"          # disables /docs, /redoc, /openapi.json
#   [ ] JWT__SECRET_KEY=<32+ char random>      # rotate; never reuse the dev placeholder
#   [ ] DB__DATABASE_URL=<managed Postgres>    # not SQLite, not localhost
#   [ ] CORS__ALLOWED_ORIGINS=<your frontend>  # exact origins, never "*" with credentials
#   [ ] CORS__FRONTEND_URL=<your frontend>     # used in verification + reset email links
#   [ ] EMAIL__RESEND_API_KEY=<live key>       # and a verified sending domain
#   [ ] EMAIL__FROM_EMAIL=<noreply@yourdomain>
#   [ ] LOGGING__USE_JSON=true                 # structured logs for the hosting platform
#   [ ] LOGGING__LEVEL="INFO"                  # not DEBUG
#   [ ] TEST__TEST_MODE=false                  # disables /api/v1/test/* (default already false)
#   [ ] RATE_LIMIT__ENABLED=true               # default is true; just confirm
#   [ ] SENTRY__DSN=<live DSN>                 # optional but recommended for error tracking
#   [ ] LLM__PROVIDER="anthropic"              # drop the Ollama container in prod; use Claude
#   [ ] LLM__ANTHROPIC_API_KEY=<live key>      # required when provider is anthropic
#   [ ] AI__ENABLED=true                       # only if shipping semantic search + assistant
#   [ ] VECTOR__QDRANT_URL=<managed Qdrant>    # server mode (Qdrant Cloud), not embedded
# ============================================================================

# Error tracking (Sentry, optional). Leave SENTRY__DSN empty in dev/tests; the init
# call is a no-op when unset, so there is zero overhead.
SENTRY__DSN=""
# Override APP__ENVIRONMENT for Sentry tagging (e.g. 'staging' while APP__ENVIRONMENT
# stays 'production'). Empty falls back to APP__ENVIRONMENT.
SENTRY__ENVIRONMENT=""
# Performance trace sample rate. 0.0 disables tracing entirely (errors still report);
# 0.1 samples 10% of requests, 1.0 traces everything (do not use in production).
SENTRY__TRACES_SAMPLE_RATE=0.0
